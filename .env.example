# ── CivicSense AI Environment Configuration ─────────────────────────────
# Copy this to .env and fill in your credentials.

# Server settings
CIVICSENSE_HOST=127.0.0.1
CIVICSENSE_PORT=8000

# SQLite DB path (default — always works offline)
CIVICSENSE_DB_PATH=./database/civicsense.db

# Supabase Cloud Database (OPTIONAL — leave empty to use SQLite)
# Create free project at https://supabase.com → get URL + anon key
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=

# NYC OpenData API settings
NYC_311_API_URL=https://data.cityofnewyork.us/resource/erm2-nwe9.json
NYC_311_DEFAULT_LIMIT=10
