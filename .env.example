# ── CivicSense AI Environment Configuration ─────────────────────────────
# Fill in your credentials below.

# Server settings
CIVICSENSE_HOST=127.0.0.1
CIVICSENSE_PORT=8000

# SQLite DB path (default clean fallback with 0 demo complaints)
CIVICSENSE_DB_PATH=./database/civicsense.db

# ── Firebase Firestore Cloud Database ────────────────────────────────────
# Option A: Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./database/firebase_credentials.json

# Option B: Or paste raw JSON string in one line:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option C: Web API Key / Project ID:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# ── LLM Chatbot Engine (Google Gemini / OpenAI) ─────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional OpenAI or Groq API key:
OPENAI_API_KEY=
GROQ_API_KEY=

# ── Master Admin Passkey ────────────────────────────────────────────────
ADMIN_PASSKEY=GWMC-ADMIN-2026
